# Malaysia AI Tour Guide — Production Environment (.env.production)
# Usage: Copy to .env.production when building production bundle: npm run build

VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_PROJECT_ID=msiatguide
VITE_FIREBASE_API_KEY=AIzaSy_PRODUCTION_KEY_HERE

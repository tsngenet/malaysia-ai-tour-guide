rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminOrOperator() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'operator'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 10 * 1024 * 1024; // Max 10MB
    }

    // Attraction hero & gallery visuals: public read, admin write
    match /attractions/{placeId}/{fileName} {
      allow read: if true;
      allow write: if isAdminOrOperator() && isValidImage();
    }

    // Community contributions: read public, authenticated create, admin/operator update & delete
    match /contributions/{contributionId}/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidImage();
      allow update, delete: if isAdminOrOperator() && isValidImage();
    }

    // User profile avatars
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

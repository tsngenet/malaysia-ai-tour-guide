{
  "name": "malaysia-ai-tour-guide",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "test": "node test_route_builder.mjs && node test_integration.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:rules:poi": "npx firebase-tools emulators:exec --only firestore,storage --project demo-poi-test \"node scripts/test_poi_rules_emulator.mjs\"",
    "test:e2e:poi": "npx firebase-tools emulators:exec --only auth,firestore --project demo-poi-e2e \"node scripts/test_poi_integration_e2e.mjs\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "firebase": "^13.2.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "playwright": "^1.65.0"
  }
}

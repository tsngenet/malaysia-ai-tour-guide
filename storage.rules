rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function role() { return request.auth != null ? request.auth.token.get('role', '') : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isReviewer() { return role() == 'reviewer' || isAdmin(); }
    function isStaff() { return role() in ['driver', 'contributor', 'reviewer', 'admin']; }
    function validImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /poiMedia/public/{poiId}/{file} {
      allow read: if true;
      allow create, update: if isReviewer() && validImage();
      allow delete: if isAdmin();
    }

    match /poiMedia/pending/{poiId}/{file} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

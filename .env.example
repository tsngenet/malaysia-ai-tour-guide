# ===================================================================
# Malaysia AI Live Tour Guide (mytguide) - Environment Configuration
# ===================================================================

# Server Port
PORT=3000

# Server-Side AI Provider (Keep on server, NEVER prefix with VITE_)
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# AI_API_KEY=your_openai_key_here
# AI_MODEL=gpt-4o-mini

# ===================================================================
# Client-Side Static Map Provider Configuration
# ===================================================================
# Options:
# - 'none' (Default & Recommended): Purely local. Uses approved local attraction visuals
#   from src/data/attractions.js or an elegant topographic SVG fallback. Zero external billing.
# - 'google': Uses Google Maps Static API for satellite snapshots.
#   Requires a restricted Google Maps Platform API key.
# ===================================================================
# Firebase Client Configuration (Multi-Environment)
# ===================================================================
# Set to 'false' in deployed environments; 'true' to force local emulators
VITE_USE_FIREBASE_EMULATOR=true

# Staging defaults:
VITE_FIREBASE_PROJECT_ID=msiatguide-staging
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=msiatguide-staging.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=msiatguide-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Client-Side Static Map Provider Configuration
VITE_STATIC_MAP_PROVIDER=none

# Google Maps API Key (Optional)
# If set, MUST be restricted in Google Cloud Console:
# 1. Application restrictions: HTTP referrers (e.g. https://mytguide.web.app/*, http://localhost:*)
# 2. API restrictions: Maps Static API only
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL.
VITE_GOOGLE_MAPS_API_KEY=
